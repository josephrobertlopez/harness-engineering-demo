{
  "description": "Specgate multi-layer acceptance testing framework hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pretooluse-commit-check.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
