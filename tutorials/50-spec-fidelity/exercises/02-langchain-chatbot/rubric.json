{
  "vague_terms": [
    "should",
    "stuff",
    "smart",
    "bad",
    "easy",
    "safe",
    "has memory"
  ],
  "prd_facts": [
    {
      "label": "that answers come only from the matched FAQ entry",
      "source": "stakeholder-answers.md Q1",
      "any_of": [
        "entry (alone|only)\\b",
        "only (from|on) (the|that)[^\\n]*(entry|faq)",
        "(using|from) only the (matched|matching|retrieved|selected|best) (faq )?entry"
      ],
      "examples": [
        "and MUST instruct the model to answer from that entry alone.",
        "The bot SHALL answer using only the matched entry."
      ],
      "counterexamples": [
        "The bot SHALL answer any question, using the FAQ where it helps."
      ]
    },
    {
      "label": "the exact escalation reply",
      "source": "stakeholder-answers.md Q2",
      "any_of": [
        "I don['’]t know that one yet"
      ]
    },
    {
      "label": "that an escalated turn is marked as escalated",
      "source": "stakeholder-answers.md Q2",
      "any_of": [
        "\\bescalated\\b"
      ]
    },
    {
      "label": "that an uncovered question makes no model call",
      "source": "stakeholder-answers.md Q2",
      "any_of": [
        "(MUST NOT|SHALL NOT|never|no|not|without)\\s+(\\w+\\s+){0,3}?(model call|call(ing)? the model|invok\\w* the model)",
        "model (is |MUST |SHALL )?(not|never) (be )?(called|invoked)"
      ],
      "examples": [
        "and make no model call for that turn.",
        "The bot MUST NOT call the model.",
        "It replies without calling the model."
      ],
      "counterexamples": [
        "When the FAQ does not cover it, the bot SHALL call the model to phrase an apology."
      ]
    },
    {
      "label": "the memory window",
      "source": "stakeholder-answers.md Q3",
      "any_of": [
        "\\b(6|six)[- ]messages?\\b",
        "last (6|six)\\b"
      ],
      "examples": [
        "The bot SHALL send the last 6 messages",
        "a six-message window"
      ]
    },
    {
      "label": "that sessions are isolated",
      "source": "stakeholder-answers.md Q3",
      "any_of": [
        "isolated",
        "separate (per )?sessions?",
        "per[- ]session"
      ]
    },
    {
      "label": "that memory is never written to disk",
      "source": "stakeholder-answers.md Q3",
      "any_of": [
        "(MUST NOT|SHALL NOT|never|not|no)\\b[^\\n]*\\bdisk\\b",
        "in[- ](process|memory) only"
      ]
    },
    {
      "label": "which sensitive data is refused",
      "source": "stakeholder-answers.md Q4",
      "any_of": [
        "card number"
      ]
    },
    {
      "label": "what counts as a card number",
      "source": "stakeholder-answers.md Q4",
      "any_of": [
        "\\bLuhn\\b"
      ]
    },
    {
      "label": "what counts as a shared password",
      "source": "stakeholder-answers.md Q4",
      "any_of": [
        "digit or (a )?(symbol|special character)",
        "(symbol|special character) or (a )?digit"
      ]
    },
    {
      "label": "the exact refusal reply",
      "source": "stakeholder-answers.md Q4",
      "any_of": [
        "I can['’]t help with passwords or card numbers here"
      ]
    },
    {
      "label": "that refused messages are not remembered",
      "source": "stakeholder-answers.md Q4",
      "any_of": [
        "(MUST NOT|SHALL NOT|never|not)\\s+(be\\s+)?(\\w+\\s+){0,2}?(kept|stored|remembered|added|saved|recorded)\\b[^\\n]*(memory|history)"
      ],
      "examples": [
        "The refused message MUST NOT be kept in memory.",
        "It MUST never be stored in the session history.",
        "and it is not added to the history"
      ],
      "counterexamples": [
        "The refused message SHALL be kept in memory so the agent has context."
      ]
    },
    {
      "label": "the model id",
      "source": "stakeholder-answers.md Q5",
      "any_of": [
        "claude-sonnet-5"
      ],
      "none_of": [
        "claude-sonnet-5-\\d"
      ]
    },
    {
      "label": "max_tokens",
      "source": "stakeholder-answers.md Q5",
      "any_of": [
        "max_tokens`?\\W{0,3}(\\w+\\W{1,3}){0,2}512"
      ],
      "examples": [
        "`max_tokens` 512",
        "max_tokens=512",
        "max_tokens set to 512"
      ]
    },
    {
      "label": "that temperature is not set",
      "source": "stakeholder-answers.md Q5",
      "any_of": [
        "(MUST NOT|SHALL NOT|never|not|no)\\s+(\\w+\\s+){0,2}?`?temperature",
        "temperature`? (MUST|SHALL) (NOT|never) be"
      ],
      "none_of": [
        "(set|pass|use)\\w*\\s+`?temperature`?\\s*(to|=|of|at)\\s*\\d"
      ],
      "examples": [
        "and MUST NOT set `temperature` (the API returns 400 for it on this model)",
        "no temperature is sent"
      ],
      "counterexamples": [
        "The bot SHALL set temperature to 0.7 for friendlier answers."
      ]
    },
    {
      "label": "where the API key comes from",
      "source": "stakeholder-answers.md Q5",
      "any_of": [
        "ANTHROPIC_API_KEY",
        "from the environment"
      ]
    },
    {
      "label": "how to try it",
      "source": "stakeholder-answers.md Q6",
      "any_of": [
        "python chatbot\\.py"
      ]
    },
    {
      "label": "how the terminal chat ends",
      "source": "stakeholder-answers.md Q6",
      "any_of": [
        "end[- ]of[- ]input",
        "\\bEOF\\b",
        "Ctrl-D"
      ]
    }
  ],
  "impl_rules": [
    {
      "label": "the model is called through LangChain's ChatAnthropic",
      "glob": "*.py",
      "must_match": [
        "^\\s*from langchain_anthropic import [^\\n]*\\bChatAnthropic\\b",
        "\\bChatAnthropic\\s*\\("
      ]
    },
    {
      "label": "model id exactly as specified",
      "glob": "*.py",
      "must_match": [
        "[\"']claude-sonnet-5[\"']"
      ],
      "must_not_match": [
        "claude-sonnet-5-\\d{6,}"
      ]
    },
    {
      "label": "temperature is never sent",
      "glob": "*.py",
      "must_not_match": [
        "\\btemperature\\b[\"']?\\s*[=:]"
      ]
    },
    {
      "label": "no API key in source",
      "glob": "*.py",
      "must_not_match": [
        "sk-ant-",
        "api_key[\"']?\\s*[=:]\\s*[\"']"
      ]
    }
  ]
}
