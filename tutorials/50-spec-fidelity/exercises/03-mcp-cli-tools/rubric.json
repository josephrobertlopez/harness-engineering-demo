{
  "vague_terms": [
    "should",
    "stuff",
    "whatever",
    "safe",
    "etc",
    "dangerous"
  ],
  "prd_facts": [
    {
      "label": "which CLIs are allowed",
      "source": "stakeholder-answers.md Q1",
      "any_of": [
        "\\bgit\\b[^\\n]*\\b(rg|ripgrep)\\b",
        "\\b(rg|ripgrep)\\b[^\\n]*\\bgit\\b"
      ]
    },
    {
      "label": "the git_status tool",
      "source": "stakeholder-answers.md Q2",
      "any_of": [
        "git_status"
      ]
    },
    {
      "label": "the git_log tool",
      "source": "stakeholder-answers.md Q2",
      "any_of": [
        "git_log"
      ]
    },
    {
      "label": "git_log's limit range and default",
      "source": "stakeholder-answers.md Q2",
      "any_of": [
        "1\\s*(to|-|–|through)\\s*50\\b[^\\n]*default\\s*(of\\s*|is\\s*|=\\s*)?10\\b",
        "default\\s*(of\\s*|is\\s*|=\\s*)?10\\b[^\\n]*1\\s*(to|-|–|through)\\s*50\\b"
      ],
      "examples": [
        "with `limit` an integer from 1 to 50, default 10."
      ]
    },
    {
      "label": "the git_diff_stat tool",
      "source": "stakeholder-answers.md Q2",
      "any_of": [
        "git_diff_stat"
      ]
    },
    {
      "label": "the rg_search tool",
      "source": "stakeholder-answers.md Q2",
      "any_of": [
        "rg_search"
      ]
    },
    {
      "label": "that the pattern is passed after -e and --",
      "source": "stakeholder-answers.md Q4",
      "any_of": [
        "-e\\b[^\\n]*\\s--\\s",
        "after `?-e`?"
      ]
    },
    {
      "label": "that rg exit status 1 is a success",
      "source": "stakeholder-answers.md Q5",
      "any_of": [
        "exit (status|code) 1\\b[^\\n]*(success|not an error)",
        "(success|not an error)[^\\n]*exit (status|code) 1\\b"
      ],
      "examples": [
        "Exit status 1 (no matches) MUST be a successful result."
      ]
    },
    {
      "label": "the root directory",
      "source": "stakeholder-answers.md Q3",
      "any_of": [
        "--root"
      ]
    },
    {
      "label": "that paths outside the root are rejected",
      "source": "stakeholder-answers.md Q3",
      "any_of": [
        "(outside|escapes?) (of )?the root"
      ]
    },
    {
      "label": "no shell",
      "source": "stakeholder-answers.md Q4",
      "any_of": [
        "no shell",
        "without a shell",
        "never[^\\n]*shell",
        "argument list"
      ],
      "none_of": [
        "shell=True",
        "(through|via|in) a shell\\b"
      ],
      "counterexamples": [
        "Commands SHALL be run through a shell so pipes work."
      ]
    },
    {
      "label": "the timeout",
      "source": "stakeholder-answers.md Q4",
      "any_of": [
        "\\b10[ -]?s(ec(ond)?s?)?\\b",
        "ten seconds"
      ]
    },
    {
      "label": "the output cap",
      "source": "stakeholder-answers.md Q4",
      "any_of": [
        "\\b8[,_ ]?000\\b"
      ],
      "examples": [
        "output cut at 8000 characters",
        "truncated at 8,000 characters"
      ]
    },
    {
      "label": "stdio transport",
      "source": "stakeholder-answers.md Q5",
      "any_of": [
        "\\bstdio\\b"
      ]
    },
    {
      "label": "the protocol version",
      "source": "stakeholder-answers.md Q5",
      "any_of": [
        "2025-06-18"
      ]
    },
    {
      "label": "which MCP methods the server answers",
      "source": "stakeholder-answers.md Q5",
      "any_of": [
        "tools/list[^\\n]*tools/call",
        "tools/call[^\\n]*tools/list"
      ],
      "examples": [
        "answering `initialize`, `ping`, `tools/list`\nand `tools/call`"
      ]
    },
    {
      "label": "the unknown-tool error code",
      "source": "stakeholder-answers.md Q5",
      "any_of": [
        "-32602"
      ]
    },
    {
      "label": "the unknown-method error code",
      "source": "stakeholder-answers.md Q5",
      "any_of": [
        "-32601"
      ]
    },
    {
      "label": "the parse error code",
      "source": "stakeholder-answers.md Q5",
      "any_of": [
        "-32700"
      ]
    },
    {
      "label": "that tool failures are isError results",
      "source": "stakeholder-answers.md Q5",
      "any_of": [
        "isError"
      ]
    },
    {
      "label": "how to register it with Claude Code",
      "source": "stakeholder-answers.md Q6",
      "any_of": [
        "claude mcp add"
      ]
    }
  ],
  "impl_rules": [
    {
      "label": "never a shell",
      "glob": "server.py",
      "must_not_match": [
        "shell\\s*=\\s*True",
        "\\bos\\.system\\s*\\(",
        "\\bos\\.popen\\s*\\(",
        "\\bexec\\s*\\(",
        "\\beval\\s*\\("
      ]
    },
    {
      "label": "agreed protocol version",
      "glob": "server.py",
      "must_match": [
        "2025-06-18"
      ]
    },
    {
      "label": "a 10 second timeout is declared",
      "glob": "server.py",
      "must_match": [
        "\\b(TIMEOUT\\w*|timeout\\w*)\\s*[:=]\\s*10(\\.0)?\\b"
      ]
    },
    {
      "label": "an 8000-character output cap is declared",
      "glob": "server.py",
      "must_match": [
        "[:=]\\s*8_?000\\b"
      ]
    },
    {
      "label": "project registration file for Claude Code",
      "glob": ".mcp.json",
      "must_match": [
        "\"mcpServers\"",
        "--root"
      ]
    },
    {
      "label": "a real MCP client can talk to it",
      "mcp_smoke": "server.py",
      "protocol": "2025-06-18",
      "tools": [
        "git_diff_stat",
        "git_log",
        "git_status",
        "rg_search"
      ],
      "unknown_tool_code": -32602,
      "call": "git_status",
      "must_refuse": [
        {
          "tool": "git_log",
          "arguments": {
            "limit": 51
          },
          "why": "the product owner set limit to 1-50"
        },
        {
          "tool": "git_log",
          "arguments": {
            "limit": 0
          },
          "why": "the product owner set limit to 1-50"
        },
        {
          "tool": "git_log",
          "arguments": {
            "limit": true
          },
          "why": "a boolean is not an integer limit"
        },
        {
          "tool": "rg_search",
          "arguments": {
            "pattern": "x",
            "path": "../.."
          },
          "why": "paths outside the root must be rejected"
        },
        {
          "tool": "rg_search",
          "arguments": {
            "pattern": ""
          },
          "why": "pattern must be a non-empty string"
        },
        {
          "tool": "git_status",
          "arguments": {
            "args": "--all"
          },
          "why": "arguments the product owner did not list must be rejected"
        }
      ],
      "controls": {
        "git_log": {
          "limit": 2
        },
        "rg_search": {
          "pattern": "fixture"
        },
        "git_status": {}
      }
    }
  ]
}
